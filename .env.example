# DeepLearnX Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini Generative AI API Key (Required for Dynamic Syllabus Generator)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (options: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-2.5-flash)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# Server Port
PORT=8055
