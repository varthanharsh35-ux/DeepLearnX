# DeepLearnX Environment Configuration
# Copy this file to .env and configure your keys to enable live cloud LLM question generation.
# If no keys are provided, DeepLearnX operates in authentic offline knowledge synthesis mode.

# Google Gemini API Key (Recommended for fast dynamic syllabus generation)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.5-flash, gemini-3.5-flash-lite, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash

# OpenAI API Key (Alternative provider)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Default OpenAI Model (options: gpt-4o-mini, gpt-4o)
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# LLM Provider Dispatcher Options
# Provider selection: 'auto' (prioritizes Gemini if configured, then OpenAI), 'gemini', or 'openai'
LLM_PROVIDER=auto

# Request timeout in seconds (default: 30.0)
LLM_REQUEST_TIMEOUT=30.0

# Maximum retries on transient errors (default: 2)
LLM_MAX_RETRIES=2

# Enable automatic failover to alternate provider when configured (default: true)
LLM_FALLBACK_ENABLED=true

# Model sampling temperature (default: 0.2)
LLM_TEMPERATURE=0.2

# Server Port
PORT=8055

