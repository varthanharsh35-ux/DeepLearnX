# DeepLearnX Environment Configuration
# Copy this file to .env and configure your keys to enable live cloud LLM question generation.
# If no keys are provided, DeepLearnX operates in authentic offline knowledge synthesis mode.

# Google Gemini API Key (Recommended for fast dynamic syllabus generation)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-2.0-flash-lite)
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative provider)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Default OpenAI Model (options: gpt-4o-mini, gpt-4o)
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Server Port
PORT=8055
